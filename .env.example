# Required: PostgreSQL connection string.
# - Railway: automatically injected via DATABASE_URL or DATABASE_PRIVATE_URL when you attach a Postgres service
# - Render: "Internal Database URL"
DATABASE_URL=postgres://user:password@host:5432/zeus

# Optional: overrides the port; Railway and Render inject PORT automatically.
PORT=3000

# Optional: Cloudflare API credentials used only by existing panel features
# (/api/users live request counters, /api/update-panel, /api/auto-update-setup).
# Leave empty to keep those features dormant, exactly like a Worker without bindings.
CF_API_TOKEN=
CF_ACCOUNT_ID=
WORKER_NAME=zeus-panel

# Optional: public base URL of this deployment (informational).
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Optional tuning
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
# Force TLS on the PostgreSQL connection even if DATABASE_URL has no sslmode param.
DATABASE_SSL=false
